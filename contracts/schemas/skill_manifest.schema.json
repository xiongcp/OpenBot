{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill_manifest.schema.json",
  "title": "skill_manifest.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "skill_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "source_uri": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "skill_id",
    "name",
    "version",
    "source_uri",
    "license",
    "sha256",
    "required_capabilities"
  ],
  "additionalProperties": false
}
