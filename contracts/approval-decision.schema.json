{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "approval-decision.schema.json",
  "title": "approval-decision.schema.json",
  "type": "object",
  "properties": {
    "decision": {
      "enum": [
        "APPROVE",
        "DENY"
      ]
    },
    "nonce": {
      "type": "string",
      "minLength": 32,
      "maxLength": 256
    },
    "expected_binding_hash": {
      "$ref": "./common.schema.json#/$defs/Hash"
    },
    "expected_version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "decision",
    "nonce",
    "expected_binding_hash",
    "expected_version"
  ],
  "additionalProperties": false,
  "description": "Actor identity is derived from authenticated request context, never accepted from this body."
}
