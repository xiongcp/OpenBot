{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "create-task.schema.json",
  "title": "create-task.schema.json",
  "type": "object",
  "properties": {
    "workspace_id": {
      "$ref": "./common.schema.json#/$defs/Id"
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "session_id": {
      "$ref": "./common.schema.json#/$defs/Id"
    },
    "network_mode": {
      "enum": [
        "CONNECTED",
        "LOCAL_MODEL",
        "OFFLINE"
      ]
    },
    "artifact_ids": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "./common.schema.json#/$defs/Id"
      }
    }
  },
  "required": [
    "workspace_id",
    "goal",
    "network_mode"
  ],
  "additionalProperties": false
}
