{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "operation-snapshot.schema.json",
  "title": "operation-snapshot.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "operation_id": {
      "$ref": "./common.schema.json#/$defs/Id"
    },
    "task_id": {
      "$ref": "./common.schema.json#/$defs/Id"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "$ref": "./common.schema.json#/$defs/OperationState"
    },
    "binding_hash": {
      "$ref": "./common.schema.json#/$defs/Hash"
    },
    "retry_class": {
      "$ref": "./common.schema.json#/$defs/RetryClass"
    },
    "effect": {
      "enum": [
        "READ",
        "LOCAL_WRITE",
        "EXTERNAL_WRITE",
        "CODE_EXECUTION"
      ]
    },
    "last_attempt_id": {
      "anyOf": [
        {
          "$ref": "./common.schema.json#/$defs/Id"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifact_ids": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "./common.schema.json#/$defs/Id"
      }
    },
    "reconciliation_options": {
      "type": "array",
      "items": {
        "enum": [
          "CONFIRMED_SUCCEEDED",
          "CONFIRMED_FAILED_NO_EFFECT",
          "KEEP_UNKNOWN"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "operation_id",
    "task_id",
    "version",
    "state",
    "binding_hash",
    "retry_class",
    "effect",
    "last_attempt_id",
    "artifact_ids",
    "reconciliation_options"
  ],
  "additionalProperties": false
}
