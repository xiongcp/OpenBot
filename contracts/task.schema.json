{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task.schema.json",
  "title": "task.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "task_id": {
      "$ref": "./common.schema.json#/$defs/Id"
    },
    "session_id": {
      "$ref": "./common.schema.json#/$defs/Id"
    },
    "workspace_id": {
      "$ref": "./common.schema.json#/$defs/Id"
    },
    "goal_summary": {
      "type": "string",
      "maxLength": 2000
    },
    "state": {
      "$ref": "./common.schema.json#/$defs/TaskState"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "last_event_seq": {
      "type": "integer",
      "minimum": 0
    },
    "cancel_requested_at_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "created_at_ms": {
      "$ref": "./common.schema.json#/$defs/UtcMs"
    },
    "updated_at_ms": {
      "$ref": "./common.schema.json#/$defs/UtcMs"
    },
    "unresolved_operation_ids": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "./common.schema.json#/$defs/Id"
      }
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "session_id",
    "workspace_id",
    "goal_summary",
    "state",
    "version",
    "last_event_seq",
    "cancel_requested_at_ms",
    "created_at_ms",
    "updated_at_ms",
    "unresolved_operation_ids"
  ],
  "additionalProperties": false
}
