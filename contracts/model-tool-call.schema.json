{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model-tool-call.schema.json",
  "title": "model-tool-call.schema.json",
  "type": "object",
  "properties": {
    "tool_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
    },
    "args": {
      "type": "object",
      "maxProperties": 64
    }
  },
  "required": [
    "tool_name",
    "args"
  ],
  "additionalProperties": false,
  "description": "Untrusted model output only. Resolve and validate against the local Tool Manifest before creating an OperationProposal."
}
