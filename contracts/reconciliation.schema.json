{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reconciliation.schema.json",
  "title": "reconciliation.schema.json",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "expected_version": {
          "type": "integer",
          "minimum": 1
        },
        "outcome": {
          "enum": [
            "CONFIRMED_SUCCEEDED",
            "CONFIRMED_FAILED_NO_EFFECT"
          ]
        },
        "evidence_artifact_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "./common.schema.json#/$defs/Id"
          }
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "expected_version",
        "outcome",
        "evidence_artifact_ids"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "expected_version": {
          "type": "integer",
          "minimum": 1
        },
        "outcome": {
          "const": "KEEP_UNKNOWN"
        },
        "evidence_artifact_ids": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "./common.schema.json#/$defs/Id"
          }
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "expected_version",
        "outcome"
      ],
      "additionalProperties": false
    }
  ]
}
