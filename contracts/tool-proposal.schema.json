{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tool-proposal.schema.json",
  "title": "tool-proposal.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "operation_id": {
      "$ref": "./common.schema.json#/$defs/Id"
    },
    "profile_id": {
      "$ref": "./common.schema.json#/$defs/Id"
    },
    "principal_id": {
      "$ref": "./common.schema.json#/$defs/Id"
    },
    "session_id": {
      "$ref": "./common.schema.json#/$defs/Id"
    },
    "task_id": {
      "$ref": "./common.schema.json#/$defs/Id"
    },
    "workspace_id": {
      "$ref": "./common.schema.json#/$defs/Id"
    },
    "tool": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "manifest_digest": {
          "$ref": "./common.schema.json#/$defs/Hash"
        }
      },
      "required": [
        "name",
        "version",
        "manifest_digest"
      ],
      "additionalProperties": false
    },
    "args": {
      "type": "object",
      "maxProperties": 64,
      "description": "Tool-specific manifest schema MUST also validate these args. Generic proposal validation alone is not sufficient."
    },
    "resource_snapshot": {
      "type": "object",
      "properties": {
        "workspace_generation": {
          "type": "integer",
          "minimum": 1
        },
        "files": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "relative_path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "sha256": {
                "$ref": "./common.schema.json#/$defs/Hash"
              }
            },
            "required": [
              "relative_path",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "browser": {
          "type": "object",
          "properties": {
            "profile_id": {
              "$ref": "./common.schema.json#/$defs/Id"
            },
            "page_id": {
              "$ref": "./common.schema.json#/$defs/Id"
            },
            "frame_id": {
              "type": "string",
              "maxLength": 256
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "origin": {
              "type": "string",
              "maxLength": 2048
            },
            "account_ref": {
              "type": "string",
              "maxLength": 200
            }
          },
          "required": [
            "profile_id",
            "page_id",
            "frame_id",
            "revision",
            "origin",
            "account_ref"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "workspace_generation",
        "files"
      ],
      "additionalProperties": false
    },
    "effect": {
      "enum": [
        "READ",
        "LOCAL_WRITE",
        "EXTERNAL_WRITE",
        "CODE_EXECUTION"
      ]
    },
    "retry_class": {
      "$ref": "./common.schema.json#/$defs/RetryClass"
    },
    "data_class": {
      "$ref": "./common.schema.json#/$defs/DataClass"
    },
    "destination": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "LOCAL",
            "MODEL_PROVIDER",
            "MESSAGE_RECIPIENT",
            "WEB_ORIGIN",
            "MCP_SERVER"
          ]
        },
        "resource_ref": {
          "type": "string",
          "maxLength": 2048
        },
        "account_ref": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "kind",
        "resource_ref"
      ],
      "additionalProperties": false
    },
    "policy_version": {
      "type": "string",
      "maxLength": 80
    },
    "identity_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "expires_at_ms": {
      "$ref": "./common.schema.json#/$defs/UtcMs"
    },
    "approval_nonce_hash": {
      "$ref": "./common.schema.json#/$defs/Hash"
    },
    "provider_idempotency_key": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "binding_hash": {
      "$ref": "./common.schema.json#/$defs/Hash"
    }
  },
  "required": [
    "schema_version",
    "operation_id",
    "profile_id",
    "principal_id",
    "session_id",
    "task_id",
    "workspace_id",
    "tool",
    "args",
    "resource_snapshot",
    "effect",
    "retry_class",
    "data_class",
    "destination",
    "policy_version",
    "identity_epoch",
    "expires_at_ms",
    "approval_nonce_hash",
    "provider_idempotency_key",
    "binding_hash"
  ],
  "additionalProperties": false,
  "description": "Server-created immutable operation proposal. LLMs cannot supply identity, policy, retry class or authorization fields. binding_hash is excluded from its own digest input."
}
