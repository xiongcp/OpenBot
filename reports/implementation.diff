+-- OpenBot v1.1 DESIGN BASELINE, not a migration from an existing installation.
+-- One database per profile. Requires SQLite >= 3.38 with JSON and STRICT support.
+-- The migration runner owns BEGIN/COMMIT and schema_migrations checksum insertion.
+-- Before BEGIN, each writer must enable foreign_keys, WAL, synchronous=FULL and
+-- recursive_triggers, then verify their effective values. See db/README.md.
+-- There are deliberately no IF NOT EXISTS clauses and no ON DELETE CASCADE.
+-- UTC timestamps are integer milliseconds. IDs are generated by the application.
+-- JSON validity is a structural guard; canonicalization and schema validation
+-- remain application responsibilities. No secrets are stored in these columns.
+
+CREATE TABLE schema_migrations (
+    version INTEGER PRIMARY KEY CHECK (version > 0),
+    name TEXT NOT NULL CHECK (length(trim(name)) > 0),
+    checksum TEXT NOT NULL CHECK (length(checksum) = 64 AND checksum NOT GLOB '*[^0-9a-f]*'),
+    applied_at INTEGER NOT NULL CHECK (applied_at >= 0)
+) STRICT;
+
+CREATE TABLE policy_revisions (
+    version INTEGER PRIMARY KEY CHECK (version > 0),
+    digest TEXT NOT NULL UNIQUE CHECK (length(digest) = 64 AND digest NOT GLOB '*[^0-9a-f]*'),
+    rules_json TEXT NOT NULL CHECK (CASE WHEN json_valid(rules_json) THEN json_type(rules_json) = 'object' ELSE 0 END),
+    effective_at INTEGER NOT NULL CHECK (effective_at >= 0),
+    created_at INTEGER NOT NULL CHECK (created_at >= 0)
+) STRICT;
+
+CREATE TABLE runtime_instances (
+    runtime_epoch TEXT PRIMARY KEY CHECK (length(trim(runtime_epoch)) > 0),
+    boot_id TEXT NOT NULL CHECK (length(trim(boot_id)) > 0),
+    supervisor_ref TEXT NOT NULL CHECK (length(trim(supervisor_ref)) > 0),
+    state TEXT NOT NULL CHECK (state IN ('STARTING','ACTIVE','DRAINING','STOPPED','LOST')),
+    started_at INTEGER NOT NULL CHECK (started_at >= 0),
+    heartbeat_at INTEGER NOT NULL CHECK (heartbeat_at >= 0),
+    ended_at INTEGER CHECK (ended_at IS NULL OR ended_at >= 0)
+) STRICT;
+CREATE UNIQUE INDEX uq_runtime_live ON runtime_instances ((1))
+    WHERE state IN ('STARTING','ACTIVE','DRAINING');
+
+CREATE TABLE profile_config (
+    singleton INTEGER PRIMARY KEY CHECK (singleton = 1),
+    profile_id TEXT NOT NULL UNIQUE CHECK (length(trim(profile_id)) > 0),
+    schema_version INTEGER NOT NULL CHECK (schema_version > 0),
+    policy_version INTEGER NOT NULL REFERENCES policy_revisions(version) ON DELETE RESTRICT,
+    identity_epoch INTEGER NOT NULL CHECK (identity_epoch > 0),
+    privacy_mode TEXT NOT NULL CHECK (privacy_mode IN ('CONNECTED','LOCAL_MODEL','OFFLINE')),
+    active_runtime_epoch TEXT REFERENCES runtime_instances(runtime_epoch) ON DELETE RESTRICT,
+    last_fencing_token INTEGER NOT NULL DEFAULT 0 CHECK (last_fencing_token >= 0),
+    version INTEGER NOT NULL DEFAULT 0 CHECK (version >= 0),
+    created_at INTEGER NOT NULL CHECK (created_at >= 0),
+    updated_at INTEGER NOT NULL CHECK (updated_at >= 0)
+) STRICT;
+
+CREATE TABLE principals (
+    principal_id TEXT PRIMARY KEY CHECK (length(trim(principal_id)) > 0),
+    role TEXT NOT NULL CHECK (role IN ('OWNER','VIEWER')),
+    status TEXT NOT NULL CHECK (status IN ('PENDING','ACTIVE','REVOKED')),
+    display_name TEXT NOT NULL,
+    created_at INTEGER NOT NULL CHECK (created_at >= 0),
+    revoked_at INTEGER CHECK (revoked_at IS NULL OR revoked_at >= 0),
+    CHECK ((status = 'REVOKED') = (revoked_at IS NOT NULL))
+) STRICT;
+CREATE UNIQUE INDEX uq_one_active_owner ON principals ((1))
+    WHERE role = 'OWNER' AND status = 'ACTIVE';
+
+CREATE TABLE channel_accounts (
+    account_id TEXT PRIMARY KEY CHECK (length(trim(account_id)) > 0),
+    channel TEXT NOT NULL CHECK (length(trim(channel)) > 0),
+    tenant_id TEXT NOT NULL CHECK (length(trim(tenant_id)) > 0),
+    app_id TEXT NOT NULL CHECK (length(trim(app_id)) > 0),
+    secret_ref TEXT NOT NULL CHECK (length(trim(secret_ref)) > 0),
+    status TEXT NOT NULL CHECK (status IN ('ACTIVE','DISABLED','REVOKED')),
+    created_at INTEGER NOT NULL CHECK (created_at >= 0),
+    UNIQUE (channel, tenant_id, app_id)
+) STRICT;
+
+CREATE TABLE channel_identities (
+    identity_id TEXT PRIMARY KEY CHECK (length(trim(identity_id)) > 0),
+    account_id TEXT NOT NULL REFERENCES channel_accounts(account_id) ON DELETE RESTRICT,
+    external_user_id TEXT NOT NULL CHECK (length(trim(external_user_id)) > 0),
+    principal_id TEXT NOT NULL REFERENCES principals(principal_id) ON DELETE RESTRICT,
+    status TEXT NOT NULL CHECK (status IN ('ACTIVE','REVOKED')),
+    linked_at INTEGER NOT NULL CHECK (linked_at >= 0),
+    UNIQUE (account_id, external_user_id)
+) STRICT;
+CREATE INDEX ix_identity_principal ON channel_identities(principal_id, status);
+
+CREATE TABLE workspaces (
+    workspace_id TEXT PRIMARY KEY CHECK (length(trim(workspace_id)) > 0),
+    root_ref TEXT NOT NULL CHECK (length(trim(root_ref)) > 0),
+    generation INTEGER NOT NULL CHECK (generation > 0),
+    status TEXT NOT NULL CHECK (status IN ('ACTIVE','DISABLED','REVOKED')),
+    version INTEGER NOT NULL DEFAULT 0 CHECK (version >= 0),
+    created_at INTEGER NOT NULL CHECK (created_at >= 0),
+    updated_at INTEGER NOT NULL CHECK (updated_at >= 0)
+) STRICT;
+
+CREATE TABLE sessions (
+    session_id TEXT PRIMARY KEY CHECK (length(trim(session_id)) > 0),
+    owner_id TEXT NOT NULL REFERENCES principals(principal_id) ON DELETE RESTRICT,
+    workspace_id TEXT REFERENCES workspaces(workspace_id) ON DELETE RESTRICT,
+    channel_identity_id TEXT REFERENCES channel_identities(identity_id) ON DELETE RESTRICT,
+    status TEXT NOT NULL CHECK (status IN ('OPEN','CLOSED','ARCHIVED')),
+    version INTEGER NOT NULL DEFAULT 0 CHECK (version >= 0),
+    created_at INTEGER NOT NULL CHECK (created_at >= 0),
+    updated_at INTEGER NOT NULL CHECK (updated_at >= 0),
+    UNIQUE (session_id, owner_id)
+) STRICT;
+
+CREATE TABLE budgets (
+    budget_id TEXT PRIMARY KEY CHECK (length(trim(budget_id)) > 0),
+    owner_id TEXT NOT NULL REFERENCES principals(principal_id) ON DELETE RESTRICT,
+    currency TEXT NOT NULL CHECK (length(currency) = 3 AND currency NOT GLOB '*[^A-Z]*'),
+    amount_limit_micros INTEGER NOT NULL CHECK (amount_limit_micros >= 0),
+    amount_spent_micros INTEGER NOT NULL DEFAULT 0 CHECK (amount_spent_micros >= 0),
+    amount_reserved_micros INTEGER NOT NULL DEFAULT 0 CHECK (amount_reserved_micros >= 0),
+    token_limit INTEGER NOT NULL CHECK (token_limit >= 0),
+    tokens_spent INTEGER NOT NULL DEFAULT 0 CHECK (tokens_spent >= 0),
+    tokens_reserved INTEGER NOT NULL DEFAULT 0 CHECK (tokens_reserved >= 0),
+    version INTEGER NOT NULL DEFAULT 0 CHECK (version >= 0),
+    created_at INTEGER NOT NULL CHECK (created_at >= 0),
+    updated_at INTEGER NOT NULL CHECK (updated_at >= 0)
+    -- Admission checks limit - spent - reserved in a writer transaction. Actual
+    -- billing is still recorded if it exceeds an estimate; CHECK must not erase it.
+) STRICT;
+
+CREATE TABLE tasks (
+    task_id TEXT PRIMARY KEY CHECK (length(trim(task_id)) > 0),
+    session_id TEXT NOT NULL,
+    owner_id TEXT NOT NULL REFERENCES principals(principal_id) ON DELETE RESTRICT,
+    budget_id TEXT NOT NULL UNIQUE REFERENCES budgets(budget_id) ON DELETE RESTRICT,
+    goal TEXT NOT NULL CHECK (length(trim(goal)) > 0),
+    state TEXT NOT NULL DEFAULT 'QUEUED' CHECK (state IN (
+        'QUEUED','RUNNING','WAITING_APPROVAL','WAITING_INPUT','WAITING_RESOURCE',
+        'RECONCILING','PAUSED','SUCCEEDED','PARTIAL','FAILED','CANCELLED')),
+    version INTEGER NOT NULL DEFAULT 0 CHECK (version >= 0),
+    cancel_revision INTEGER NOT NULL DEFAULT 0 CHECK (cancel_revision >= 0),
+    cancel_requested_at INTEGER CHECK (cancel_requested_at IS NULL OR cancel_requested_at >= 0),
+    checkpoint_json TEXT NOT NULL DEFAULT '{}' CHECK (CASE WHEN json_valid(checkpoint_json) THEN json_type(checkpoint_json) = 'object' ELSE 0 END),
+    outcome_json TEXT CHECK (outcome_json IS NULL OR CASE WHEN json_valid(outcome_json) THEN json_type(outcome_json) = 'object' ELSE 0 END),
+    created_at INTEGER NOT NULL CHECK (created_at >= 0),
+    updated_at INTEGER NOT NULL CHECK (updated_at >= 0),
+    finished_at INTEGER CHECK (finished_at IS NULL OR finished_at >= 0),
+    FOREIGN KEY (session_id, owner_id) REFERENCES sessions(session_id, owner_id) ON DELETE RESTRICT,
+    UNIQUE (task_id, owner_id),
+    CHECK ((cancel_revision = 0) = (cancel_requested_at IS NULL)),
+    CHECK ((state IN ('SUCCEEDED','PARTIAL','FAILED','CANCELLED')) = (finished_at IS NOT NULL))
+) STRICT;
+CREATE INDEX ix_tasks_schedule ON tasks(state, created_at, task_id);
+CREATE INDEX ix_tasks_session ON tasks(session_id, created_at, task_id);
+
+CREATE TABLE inbox (
+    inbox_id TEXT PRIMARY KEY CHECK (length(trim(inbox_id)) > 0),
+    source_scope TEXT NOT NULL CHECK (length(trim(source_scope)) > 0),
+    external_event_id TEXT NOT NULL CHECK (length(trim(external_event_id)) > 0),
+    channel_account_id TEXT REFERENCES channel_accounts(account_id) ON DELETE RESTRICT,
+    payload_hash TEXT NOT NULL CHECK (length(payload_hash) = 64 AND payload_hash NOT GLOB '*[^0-9a-f]*'),
+    normalized_payload_json TEXT NOT NULL CHECK (CASE WHEN json_valid(normalized_payload_json) THEN json_type(normalized_payload_json) = 'object' ELSE 0 END),
+    task_id TEXT REFERENCES tasks(task_id) ON DELETE RESTRICT,
+    status TEXT NOT NULL DEFAULT 'RECEIVED' CHECK (status IN ('RECEIVED','PROCESSED','REJECTED','FAILED')),
+    received_at INTEGER NOT NULL CHECK (received_at >= 0),
+    processed_at INTEGER CHECK (processed_at IS NULL OR processed_at >= 0),
+    UNIQUE (source_scope, external_event_id),
+    CHECK (status <> 'PROCESSED' OR (processed_at IS NOT NULL AND task_id IS NOT NULL))
+) STRICT;
+CREATE INDEX ix_inbox_pending ON inbox(status, received_at);
+
+CREATE TABLE artifacts (
+    object_id TEXT PRIMARY KEY CHECK (length(trim(object_id)) > 0),
+    object_key TEXT NOT NULL UNIQUE CHECK (length(trim(object_key)) > 0),
+    sha256 TEXT NOT NULL CHECK (length(sha256) = 64 AND sha256 NOT GLOB '*[^0-9a-f]*'),
+    mime TEXT NOT NULL CHECK (length(trim(mime)) > 0),
+    bytes INTEGER NOT NULL CHECK (bytes >= 0),
+    classification TEXT NOT NULL CHECK (classification IN ('PUBLIC','WORKSPACE','SENSITIVE','SECRET')),
+    state TEXT NOT NULL CHECK (state IN ('STAGING','AVAILABLE','QUARANTINED','TOMBSTONED')),
+    created_at INTEGER NOT NULL CHECK (created_at >= 0),
+    expires_at INTEGER CHECK (expires_at IS NULL OR expires_at >= created_at)
+) STRICT;
+CREATE INDEX ix_artifact_digest ON artifacts(sha256);
+CREATE INDEX ix_artifact_retention ON artifacts(state, expires_at);
+
+CREATE TABLE tool_registry (
+    tool_id TEXT NOT NULL CHECK (length(trim(tool_id)) > 0),
+    tool_version TEXT NOT NULL CHECK (length(trim(tool_version)) > 0),
+    manifest_digest TEXT NOT NULL CHECK (length(manifest_digest) = 64 AND manifest_digest NOT GLOB '*[^0-9a-f]*'),
+    package_digest TEXT CHECK (package_digest IS NULL OR (length(package_digest) = 64 AND package_digest NOT GLOB '*[^0-9a-f]*')),
+    installation_ref TEXT NOT NULL CHECK (length(trim(installation_ref)) > 0),
+    manifest_json TEXT NOT NULL CHECK (CASE WHEN json_valid(manifest_json) THEN json_type(manifest_json) = 'object' ELSE 0 END),
+    status TEXT NOT NULL CHECK (status IN ('ACTIVE','QUARANTINED','DISABLED','RETIRED')),
+    registered_at INTEGER NOT NULL CHECK (registered_at >= 0),
+    PRIMARY KEY (tool_id, tool_version, manifest_digest)
+) STRICT;
+CREATE UNIQUE INDEX uq_tool_active ON tool_registry(tool_id) WHERE status = 'ACTIVE';
+
+CREATE TABLE operations (
+    operation_id TEXT PRIMARY KEY CHECK (length(trim(operation_id)) > 0),
+    task_id TEXT NOT NULL,
+    ordinal INTEGER NOT NULL CHECK (ordinal > 0),
+    requested_by TEXT NOT NULL REFERENCES principals(principal_id) ON DELETE RESTRICT,
+    workspace_id TEXT REFERENCES workspaces(workspace_id) ON DELETE RESTRICT,
+    workspace_generation INTEGER CHECK (workspace_generation IS NULL OR workspace_generation > 0),
+    tool_id TEXT NOT NULL,
+    tool_version TEXT NOT NULL,
+    tool_manifest_digest TEXT NOT NULL,
+    canonical_args_json TEXT NOT NULL CHECK (CASE WHEN json_valid(canonical_args_json) THEN json_type(canonical_args_json) = 'object' ELSE 0 END),
+    resource_snapshot_json TEXT NOT NULL CHECK (CASE WHEN json_valid(resource_snapshot_json) THEN json_type(resource_snapshot_json) = 'object' ELSE 0 END),
+    destination_json TEXT NOT NULL DEFAULT '{}' CHECK (CASE WHEN json_valid(destination_json) THEN json_type(destination_json) = 'object' ELSE 0 END),
+    data_class TEXT NOT NULL CHECK (data_class IN ('PUBLIC','WORKSPACE','SENSITIVE','SECRET')),
+    authorization_kind TEXT NOT NULL CHECK (authorization_kind IN ('POLICY_ALLOW','APPROVAL')),
+    policy_version INTEGER NOT NULL REFERENCES policy_revisions(version) ON DELETE RESTRICT,
+    identity_epoch INTEGER NOT NULL CHECK (identity_epoch > 0),
+    authorization_expires_at INTEGER NOT NULL,
+    binding_hash TEXT NOT NULL CHECK (length(binding_hash) = 64 AND binding_hash NOT GLOB '*[^0-9a-f]*'),
+    retry_class TEXT NOT NULL CHECK (retry_class IN ('SAFE_READ','IDEMPOTENT_WRITE','PROVIDER_IDEMPOTENT','RECONCILE_ONLY','NON_RETRYABLE')),
+    provider_idempotency_key TEXT UNIQUE CHECK (provider_idempotency_key IS NULL OR length(trim(provider_idempotency_key)) > 0),
+    provider_retry_deadline_at INTEGER CHECK (provider_retry_deadline_at IS NULL OR provider_retry_deadline_at >= 0),
+    state TEXT NOT NULL DEFAULT 'PROPOSED' CHECK (state IN (
+        'PROPOSED','AWAITING_APPROVAL','READY','CLAIMED','DISPATCHING','SUCCEEDED',
+        'FAILED','REJECTED','EXPIRED','REVOKED','CANCELLED','UNKNOWN')),
+    version INTEGER NOT NULL DEFAULT 0 CHECK (version >= 0),
+    current_attempt_id TEXT,
+    result_artifact_id TEXT REFERENCES artifacts(object_id) ON DELETE RESTRICT,
+    result_json TEXT CHECK (result_json IS NULL OR CASE WHEN json_valid(result_json) THEN json_type(result_json) = 'object' ELSE 0 END),
+    error_code TEXT CHECK (error_code IS NULL OR length(trim(error_code)) > 0),
+    unknown_reason TEXT CHECK (unknown_reason IS NULL OR length(trim(unknown_reason)) > 0),
+    resolution_evidence_ref TEXT CHECK (resolution_evidence_ref IS NULL OR length(trim(resolution_evidence_ref)) > 0),
+    created_at INTEGER NOT NULL CHECK (created_at >= 0),
+    updated_at INTEGER NOT NULL CHECK (updated_at >= 0),
+    completed_at INTEGER CHECK (completed_at IS NULL OR completed_at >= 0),
+    FOREIGN KEY (task_id, requested_by) REFERENCES tasks(task_id, owner_id) ON DELETE RESTRICT,
+    FOREIGN KEY (tool_id, tool_version, tool_manifest_digest) REFERENCES tool_registry(tool_id, tool_version, manifest_digest) ON DELETE RESTRICT,
+    FOREIGN KEY (current_attempt_id, operation_id) REFERENCES operation_attempts(attempt_id, operation_id) ON DELETE RESTRICT DEFERRABLE INITIALLY DEFERRED,
+    UNIQUE (task_id, ordinal),
+    UNIQUE (operation_id, binding_hash, requested_by),
+    CHECK ((workspace_id IS NULL) = (workspace_generation IS NULL)),
+    CHECK (authorization_expires_at > created_at),
+    CHECK (retry_class <> 'PROVIDER_IDEMPOTENT' OR provider_idempotency_key IS NOT NULL),
+    CHECK (state <> 'UNKNOWN' OR unknown_reason IS NOT NULL),
+    CHECK ((state IN ('SUCCEEDED','FAILED','REJECTED','EXPIRED','REVOKED','CANCELLED')) = (completed_at IS NOT NULL))
+) STRICT;
+CREATE INDEX ix_operations_recovery ON operations(state, updated_at);
+CREATE INDEX ix_operations_task ON operations(task_id, ordinal);
+
+CREATE TABLE approvals (
+    approval_id TEXT PRIMARY KEY CHECK (length(trim(approval_id)) > 0),
+    operation_id TEXT NOT NULL UNIQUE,
+    allowed_actor_id TEXT NOT NULL REFERENCES principals(principal_id) ON DELETE RESTRICT,
+    actor_scope_json TEXT NOT NULL CHECK (CASE WHEN json_valid(actor_scope_json) THEN json_type(actor_scope_json) = 'object' ELSE 0 END),
+    binding_hash TEXT NOT NULL,
+    nonce_hash TEXT NOT NULL UNIQUE CHECK (length(nonce_hash) = 64 AND nonce_hash NOT GLOB '*[^0-9a-f]*'),
+    status TEXT NOT NULL DEFAULT 'PENDING' CHECK (status IN ('PENDING','APPROVED','DENIED','EXPIRED','REVOKED','CONSUMED')),
+    version INTEGER NOT NULL DEFAULT 0 CHECK (version >= 0),
+    requested_at INTEGER NOT NULL CHECK (requested_at >= 0),
+    expires_at INTEGER NOT NULL CHECK (expires_at > requested_at),
+    decided_by TEXT REFERENCES principals(principal_id) ON DELETE RESTRICT,
+    decided_at INTEGER CHECK (decided_at IS NULL OR (decided_at >= requested_at AND decided_at < expires_at)),
+    consumed_at INTEGER CHECK (consumed_at IS NULL OR (consumed_at >= requested_at AND consumed_at < expires_at)),
+    consumed_attempt_id TEXT,
+    FOREIGN KEY (operation_id, binding_hash, allowed_actor_id) REFERENCES operations(operation_id, binding_hash, requested_by) ON DELETE RESTRICT,
+    FOREIGN KEY (consumed_attempt_id, operation_id) REFERENCES operation_attempts(attempt_id, operation_id) ON DELETE RESTRICT DEFERRABLE INITIALLY DEFERRED,
+    UNIQUE (approval_id, operation_id),
+    CHECK ((decided_by IS NULL) = (decided_at IS NULL)),
+    CHECK (decided_by IS NULL OR decided_by = allowed_actor_id),
+    CHECK (status NOT IN ('APPROVED','DENIED','CONSUMED') OR decided_at IS NOT NULL),
+    CHECK (status <> 'PENDING' OR decided_at IS NULL),
+    CHECK ((status = 'CONSUMED') = (consumed_at IS NOT NULL AND consumed_attempt_id IS NOT NULL)),
+    CHECK ((consumed_at IS NULL) = (consumed_attempt_id IS NULL)),
+    CHECK (consumed_at IS NULL OR consumed_at >= decided_at)
+) STRICT;
+CREATE INDEX ix_approvals_expiry ON approvals(status, expires_at);
+
+CREATE TABLE operation_attempts (
+    attempt_id TEXT PRIMARY KEY CHECK (length(trim(attempt_id)) > 0),
+    operation_id TEXT NOT NULL REFERENCES operations(operation_id) ON DELETE RESTRICT,
+    attempt_no INTEGER NOT NULL CHECK (attempt_no > 0),
+    approval_id TEXT,
+    runtime_epoch TEXT NOT NULL REFERENCES runtime_instances(runtime_epoch) ON DELETE RESTRICT,
+    fencing_token INTEGER NOT NULL CHECK (fencing_token > 0),
+    dispatch_id TEXT NOT NULL UNIQUE CHECK (length(trim(dispatch_id)) > 0),
+    executor_id TEXT NOT NULL CHECK (length(trim(executor_id)) > 0),
+    claim_cancel_revision INTEGER NOT NULL CHECK (claim_cancel_revision >= 0),
+    claim_policy_version INTEGER NOT NULL REFERENCES policy_revisions(version) ON DELETE RESTRICT,
+    claim_identity_epoch INTEGER NOT NULL CHECK (claim_identity_epoch > 0),
+    lease_set_json TEXT NOT NULL CHECK (CASE WHEN json_valid(lease_set_json) THEN json_type(lease_set_json) = 'array' ELSE 0 END),
+    status TEXT NOT NULL CHECK (status IN ('CLAIMED','DISPATCHING','SUCCEEDED','FAILED','UNKNOWN','ABANDONED','CANCELLED')),
+    version INTEGER NOT NULL DEFAULT 0 CHECK (version >= 0),
+    created_at INTEGER NOT NULL CHECK (created_at >= 0),
+    dispatch_started_at INTEGER CHECK (dispatch_started_at IS NULL OR dispatch_started_at >= 0),
+    finished_at INTEGER CHECK (finished_at IS NULL OR finished_at >= 0),
+    receipt_json TEXT CHECK (receipt_json IS NULL OR CASE WHEN json_valid(receipt_json) THEN json_type(receipt_json) = 'object' ELSE 0 END),
+    error_code TEXT CHECK (error_code IS NULL OR length(trim(error_code)) > 0),
+    recovery_evidence_ref TEXT CHECK (recovery_evidence_ref IS NULL OR length(trim(recovery_evidence_ref)) > 0),
+    FOREIGN KEY (approval_id, operation_id) REFERENCES approvals(approval_id, operation_id) ON DELETE RESTRICT,
+    UNIQUE (operation_id, attempt_no),
+    UNIQUE (attempt_id, operation_id),
+    CHECK (status NOT IN ('DISPATCHING','SUCCEEDED','FAILED','UNKNOWN') OR dispatch_started_at IS NOT NULL),
+    CHECK (status NOT IN ('CLAIMED','ABANDONED','CANCELLED') OR dispatch_started_at IS NULL),
+    CHECK ((status IN ('SUCCEEDED','FAILED','ABANDONED','CANCELLED')) = (finished_at IS NOT NULL)),
+    CHECK (status <> 'ABANDONED' OR recovery_evidence_ref IS NOT NULL)
+) STRICT;
+CREATE UNIQUE INDEX uq_attempt_active ON operation_attempts(operation_id)
+    WHERE status IN ('CLAIMED','DISPATCHING');
+CREATE INDEX ix_attempt_recovery ON operation_attempts(runtime_epoch, status);
+
+CREATE TABLE resource_leases (
+    resource_key TEXT PRIMARY KEY CHECK (length(trim(resource_key)) > 0),
+    resource_type TEXT NOT NULL CHECK (resource_type IN ('WORKSPACE','BROWSER_PROFILE','DESKTOP_SESSION','EXTERNAL_ACCOUNT')),
+    holder_attempt_id TEXT REFERENCES operation_attempts(attempt_id) ON DELETE RESTRICT,
+    runtime_epoch TEXT REFERENCES runtime_instances(runtime_epoch) ON DELETE RESTRICT,
+    fencing_token INTEGER NOT NULL CHECK (fencing_token > 0),
+    state TEXT NOT NULL CHECK (state IN ('HELD','RELEASED','REVOKED')),
+    acquired_at INTEGER,
+    expires_at INTEGER,
+    version INTEGER NOT NULL DEFAULT 0 CHECK (version >= 0),
+    updated_at INTEGER NOT NULL CHECK (updated_at >= 0),
+    CHECK ((state = 'HELD') = (holder_attempt_id IS NOT NULL AND runtime_epoch IS NOT NULL AND acquired_at IS NOT NULL AND expires_at IS NOT NULL)),
+    CHECK (state = 'HELD' OR (holder_attempt_id IS NULL AND runtime_epoch IS NULL AND acquired_at IS NULL AND expires_at IS NULL)),
+    CHECK (acquired_at IS NULL OR (acquired_at >= 0 AND expires_at > acquired_at))
+) STRICT;
+CREATE INDEX ix_leases_expiry ON resource_leases(state, expires_at);
+
+CREATE TABLE artifact_refs (
+    ref_id TEXT PRIMARY KEY CHECK (length(trim(ref_id)) > 0),
+    object_id TEXT NOT NULL REFERENCES artifacts(object_id) ON DELETE RESTRICT,
+    owner_id TEXT NOT NULL REFERENCES principals(principal_id) ON DELETE RESTRICT,
+    scope_kind TEXT NOT NULL CHECK (scope_kind IN ('PRINCIPAL','SESSION','TASK','OPERATION')),
+    session_id TEXT REFERENCES sessions(session_id) ON DELETE RESTRICT,
+    task_id TEXT REFERENCES tasks(task_id) ON DELETE RESTRICT,
+    operation_id TEXT REFERENCES operations(operation_id) ON DELETE RESTRICT,
+    purpose TEXT NOT NULL CHECK (length(trim(purpose)) > 0),
+    created_at INTEGER NOT NULL CHECK (created_at >= 0),
+    CHECK (
+        (scope_kind = 'PRINCIPAL' AND session_id IS NULL AND task_id IS NULL AND operation_id IS NULL) OR
+        (scope_kind = 'SESSION' AND session_id IS NOT NULL AND task_id IS NULL AND operation_id IS NULL) OR
+        (scope_kind = 'TASK' AND session_id IS NULL AND task_id IS NOT NULL AND operation_id IS NULL) OR
+        (scope_kind = 'OPERATION' AND session_id IS NULL AND task_id IS NULL AND operation_id IS NOT NULL))
+) STRICT;
+CREATE UNIQUE INDEX uq_artifact_ref ON artifact_refs(
+    object_id, owner_id, scope_kind, coalesce(session_id,''), coalesce(task_id,''), coalesce(operation_id,''), purpose);
+
+CREATE TABLE messages (
+    message_id TEXT PRIMARY KEY CHECK (length(trim(message_id)) > 0),
+    task_id TEXT NOT NULL REFERENCES tasks(task_id) ON DELETE RESTRICT,
+    turn INTEGER NOT NULL CHECK (turn >= 0),
+    role TEXT NOT NULL CHECK (role IN ('SYSTEM','USER','ASSISTANT','TOOL')),
+    provider_call_id TEXT CHECK (provider_call_id IS NULL OR length(trim(provider_call_id)) > 0),
+    tool_call_id TEXT CHECK (tool_call_id IS NULL OR length(trim(tool_call_id)) > 0),
+    content_ref TEXT REFERENCES artifacts(object_id) ON DELETE RESTRICT,
+    content_json TEXT CHECK (content_json IS NULL OR CASE WHEN json_valid(content_json) THEN json_type(content_json) = 'object' ELSE 0 END),
+    provenance_json TEXT NOT NULL CHECK (CASE WHEN json_valid(provenance_json) THEN json_type(provenance_json) = 'object' ELSE 0 END),
+    created_at INTEGER NOT NULL CHECK (created_at >= 0),
+    UNIQUE (task_id, turn),
+    CHECK (content_ref IS NOT NULL OR content_json IS NOT NULL),
+    CHECK (role <> 'TOOL' OR tool_call_id IS NOT NULL)
+) STRICT;
+CREATE UNIQUE INDEX uq_tool_result ON messages(task_id, tool_call_id) WHERE role = 'TOOL';
+
+CREATE TABLE budget_reservations (
+    reservation_id TEXT PRIMARY KEY CHECK (length(trim(reservation_id)) > 0),
+    budget_id TEXT NOT NULL REFERENCES budgets(budget_id) ON DELETE RESTRICT,
+    operation_id TEXT REFERENCES operations(operation_id) ON DELETE RESTRICT,
+    call_ref TEXT NOT NULL CHECK (length(trim(call_ref)) > 0),
+    kind TEXT NOT NULL CHECK (kind IN ('MODEL','TOOL')),
+    status TEXT NOT NULL CHECK (status IN ('RESERVED','SETTLED','RELEASED','UNKNOWN')),
+    reserved_amount_micros INTEGER NOT NULL CHECK (reserved_amount_micros >= 0),
+    reserved_tokens INTEGER NOT NULL CHECK (reserved_tokens >= 0),
+    actual_amount_micros INTEGER CHECK (actual_amount_micros IS NULL OR actual_amount_micros >= 0),
+    actual_tokens INTEGER CHECK (actual_tokens IS NULL OR actual_tokens >= 0),
+    evidence_ref TEXT CHECK (evidence_ref IS NULL OR length(trim(evidence_ref)) > 0),
+    created_at INTEGER NOT NULL CHECK (created_at >= 0),
+    settled_at INTEGER CHECK (settled_at IS NULL OR settled_at >= 0),
+    UNIQUE (budget_id, call_ref),
+    CHECK (status <> 'SETTLED' OR (actual_amount_micros IS NOT NULL AND actual_tokens IS NOT NULL AND settled_at IS NOT NULL)),
+    CHECK (status NOT IN ('RESERVED','UNKNOWN') OR settled_at IS NULL)
+) STRICT;
+CREATE INDEX ix_reservations_pending ON budget_reservations(budget_id, status);
+
+CREATE TABLE outbox (
+    outbox_id TEXT PRIMARY KEY CHECK (length(trim(outbox_id)) > 0),
+    task_id TEXT REFERENCES tasks(task_id) ON DELETE RESTRICT,
+    channel_account_id TEXT REFERENCES channel_accounts(account_id) ON DELETE RESTRICT,
+    target_key TEXT NOT NULL CHECK (length(trim(target_key)) > 0),
+    target_json TEXT NOT NULL CHECK (CASE WHEN json_valid(target_json) THEN json_type(target_json) = 'object' ELSE 0 END),
+    semantic_key TEXT NOT NULL CHECK (length(trim(semantic_key)) > 0),
+    revision INTEGER NOT NULL CHECK (revision > 0),
+    payload_ref TEXT REFERENCES artifacts(object_id) ON DELETE RESTRICT,
+    payload_json TEXT NOT NULL CHECK (CASE WHEN json_valid(payload_json) THEN json_type(payload_json) = 'object' ELSE 0 END),
+    delivery_class TEXT NOT NULL CHECK (delivery_class IN ('UPSERT_REVISION','PROVIDER_IDEMPOTENT','RECONCILE_ONLY')),
+    provider_idempotency_key TEXT CHECK (provider_idempotency_key IS NULL OR length(trim(provider_idempotency_key)) > 0),
+    state TEXT NOT NULL DEFAULT 'PENDING' CHECK (state IN ('PENDING','IN_FLIGHT','SENT','UNKNOWN','DEAD','EXPIRED','SUPERSEDED')),
+    attempt_count INTEGER NOT NULL DEFAULT 0 CHECK (attempt_count >= 0),
+    version INTEGER NOT NULL DEFAULT 0 CHECK (version >= 0),
+    not_before INTEGER NOT NULL CHECK (not_before >= 0),
+    deadline INTEGER CHECK (deadline IS NULL OR deadline >= 0),
+    claim_runtime_epoch TEXT REFERENCES runtime_instances(runtime_epoch) ON DELETE RESTRICT,
+    lease_token TEXT CHECK (lease_token IS NULL OR length(trim(lease_token)) > 0),
+    lease_until INTEGER CHECK (lease_until IS NULL OR lease_until >= 0),
+    provider_receipt_json TEXT CHECK (provider_receipt_json IS NULL OR CASE WHEN json_valid(provider_receipt_json) THEN json_type(provider_receipt_json) = 'object' ELSE 0 END),
+    error_code TEXT CHECK (error_code IS NULL OR length(trim(error_code)) > 0),
+    created_at INTEGER NOT NULL CHECK (created_at >= 0),
+    updated_at INTEGER NOT NULL CHECK (updated_at >= 0),
+    UNIQUE (target_key, semantic_key, revision),
+    CHECK (delivery_class <> 'PROVIDER_IDEMPOTENT' OR provider_idempotency_key IS NOT NULL),
+    CHECK ((state = 'IN_FLIGHT') = (claim_runtime_epoch IS NOT NULL AND lease_token IS NOT NULL AND lease_until IS NOT NULL)),
+    CHECK (state = 'IN_FLIGHT' OR (claim_runtime_epoch IS NULL AND lease_token IS NULL AND lease_until IS NULL))
+) STRICT;
+CREATE INDEX ix_outbox_due ON outbox(state, not_before, created_at);
+
+CREATE TABLE events (
+    seq INTEGER PRIMARY KEY AUTOINCREMENT CHECK (seq > 0),
+    event_id TEXT NOT NULL UNIQUE CHECK (length(trim(event_id)) > 0),
+    aggregate_kind TEXT NOT NULL CHECK (length(trim(aggregate_kind)) > 0),
+    aggregate_id TEXT NOT NULL CHECK (length(trim(aggregate_id)) > 0),
+    aggregate_version INTEGER NOT NULL CHECK (aggregate_version >= 0),
+    task_id TEXT REFERENCES tasks(task_id) ON DELETE RESTRICT,
+    operation_id TEXT REFERENCES operations(operation_id) ON DELETE RESTRICT,
+    actor_principal_id TEXT REFERENCES principals(principal_id) ON DELETE RESTRICT,
+    event_type TEXT NOT NULL CHECK (length(trim(event_type)) > 0),
+    schema_version INTEGER NOT NULL CHECK (schema_version > 0),
+    trace_id TEXT NOT NULL CHECK (length(trim(trace_id)) > 0),
+    payload_json TEXT NOT NULL CHECK (CASE WHEN json_valid(payload_json) THEN json_type(payload_json) = 'object' ELSE 0 END),
+    created_at INTEGER NOT NULL CHECK (created_at >= 0)
+) STRICT;
+CREATE INDEX ix_events_task_seq ON events(task_id, seq);
+CREATE INDEX ix_events_aggregate ON events(aggregate_kind, aggregate_id, seq);
+
+-- Version increments detect accidental non-CAS updates. The expected_version
+-- predicate, affected-row check and transaction boundary still belong to code.
+CREATE TRIGGER profile_version_guard BEFORE UPDATE ON profile_config
+WHEN NEW.version <> OLD.version + 1 OR NEW.identity_epoch < OLD.identity_epoch
+  OR NEW.last_fencing_token < OLD.last_fencing_token OR NEW.profile_id IS NOT OLD.profile_id
+BEGIN SELECT RAISE(ABORT, 'profile version or identity/fence invariant'); END;
+CREATE TRIGGER workspace_version_guard BEFORE UPDATE ON workspaces
+WHEN NEW.version <> OLD.version + 1 OR NEW.generation < OLD.generation
+  OR (NEW.root_ref IS NOT OLD.root_ref AND NEW.generation <= OLD.generation)
+BEGIN SELECT RAISE(ABORT, 'workspace version or generation invariant'); END;
+CREATE TRIGGER task_version_guard BEFORE UPDATE ON tasks
+WHEN NEW.version <> OLD.version + 1 OR NEW.cancel_revision < OLD.cancel_revision
+  OR (OLD.cancel_requested_at IS NOT NULL AND NEW.cancel_requested_at IS NOT OLD.cancel_requested_at)
+BEGIN SELECT RAISE(ABORT, 'task version or cancellation invariant'); END;
+CREATE TRIGGER operation_version_guard BEFORE UPDATE ON operations
+WHEN NEW.version <> OLD.version + 1
+BEGIN SELECT RAISE(ABORT, 'operation version must increment'); END;
+CREATE TRIGGER approval_version_guard BEFORE UPDATE ON approvals
+WHEN NEW.version <> OLD.version + 1
+BEGIN SELECT RAISE(ABORT, 'approval version must increment'); END;
+CREATE TRIGGER attempt_version_guard BEFORE UPDATE ON operation_attempts
+WHEN NEW.version <> OLD.version + 1
+BEGIN SELECT RAISE(ABORT, 'attempt version must increment'); END;
+CREATE TRIGGER outbox_version_guard BEFORE UPDATE ON outbox
+WHEN NEW.version <> OLD.version + 1
+BEGIN SELECT RAISE(ABORT, 'outbox version must increment'); END;
+CREATE TRIGGER budget_version_guard BEFORE UPDATE ON budgets
+WHEN NEW.version <> OLD.version + 1
+BEGIN SELECT RAISE(ABORT, 'budget version must increment'); END;
+
+CREATE TRIGGER operation_proposal_immutable BEFORE UPDATE ON operations
+WHEN NEW.operation_id IS NOT OLD.operation_id OR NEW.task_id IS NOT OLD.task_id
+  OR NEW.ordinal IS NOT OLD.ordinal OR NEW.requested_by IS NOT OLD.requested_by
+  OR NEW.workspace_id IS NOT OLD.workspace_id OR NEW.workspace_generation IS NOT OLD.workspace_generation
+  OR NEW.tool_id IS NOT OLD.tool_id OR NEW.tool_version IS NOT OLD.tool_version
+  OR NEW.tool_manifest_digest IS NOT OLD.tool_manifest_digest
+  OR NEW.canonical_args_json IS NOT OLD.canonical_args_json
+  OR NEW.resource_snapshot_json IS NOT OLD.resource_snapshot_json
+  OR NEW.destination_json IS NOT OLD.destination_json OR NEW.data_class IS NOT OLD.data_class
+  OR NEW.authorization_kind IS NOT OLD.authorization_kind
+  OR NEW.policy_version IS NOT OLD.policy_version OR NEW.identity_epoch IS NOT OLD.identity_epoch
+  OR NEW.authorization_expires_at IS NOT OLD.authorization_expires_at
+  OR NEW.binding_hash IS NOT OLD.binding_hash OR NEW.retry_class IS NOT OLD.retry_class
+  OR NEW.provider_idempotency_key IS NOT OLD.provider_idempotency_key
+  OR NEW.created_at IS NOT OLD.created_at
+BEGIN SELECT RAISE(ABORT, 'operation proposal is immutable'); END;
+CREATE TRIGGER operation_no_replace BEFORE INSERT ON operations
+WHEN EXISTS (SELECT 1 FROM operations WHERE operation_id = NEW.operation_id OR (task_id = NEW.task_id AND ordinal = NEW.ordinal))
+BEGIN SELECT RAISE(ABORT, 'operation replacement forbidden'); END;
+CREATE TRIGGER operation_deadline_fixed BEFORE UPDATE ON operations
+WHEN OLD.provider_retry_deadline_at IS NOT NULL AND NEW.provider_retry_deadline_at IS NOT OLD.provider_retry_deadline_at
+BEGIN SELECT RAISE(ABORT, 'provider retry deadline cannot be extended or cleared'); END;
+CREATE TRIGGER operation_unknown_resolution BEFORE UPDATE ON operations
+WHEN OLD.state = 'UNKNOWN' AND NEW.state <> 'UNKNOWN' AND NEW.resolution_evidence_ref IS NULL
+BEGIN SELECT RAISE(ABORT, 'UNKNOWN requires reconciliation evidence'); END;
+CREATE TRIGGER operation_terminal_guard BEFORE UPDATE ON operations
+WHEN OLD.state IN ('SUCCEEDED','FAILED','REJECTED','EXPIRED','REVOKED','CANCELLED') AND NEW.state <> OLD.state
+BEGIN SELECT RAISE(ABORT, 'terminal operation cannot be reopened'); END;
+CREATE TRIGGER operation_no_delete BEFORE DELETE ON operations
+BEGIN SELECT RAISE(ABORT, 'operation ledger deletion requires explicit maintenance'); END;
+
+CREATE TRIGGER approval_binding_immutable BEFORE UPDATE ON approvals
+WHEN NEW.approval_id IS NOT OLD.approval_id OR NEW.operation_id IS NOT OLD.operation_id
+  OR NEW.allowed_actor_id IS NOT OLD.allowed_actor_id OR NEW.actor_scope_json IS NOT OLD.actor_scope_json
+  OR NEW.binding_hash IS NOT OLD.binding_hash OR NEW.nonce_hash IS NOT OLD.nonce_hash
+  OR NEW.requested_at IS NOT OLD.requested_at OR NEW.expires_at IS NOT OLD.expires_at
+  OR (OLD.decided_at IS NOT NULL AND (NEW.decided_at IS NOT OLD.decided_at OR NEW.decided_by IS NOT OLD.decided_by))
+  OR (OLD.consumed_at IS NOT NULL AND (NEW.consumed_at IS NOT OLD.consumed_at OR NEW.consumed_attempt_id IS NOT OLD.consumed_attempt_id))
+BEGIN SELECT RAISE(ABORT, 'approval binding and recorded decision are immutable'); END;
+CREATE TRIGGER approval_status_guard BEFORE UPDATE ON approvals
+WHEN NEW.status <> OLD.status AND NOT (
+    (OLD.status = 'PENDING' AND NEW.status IN ('APPROVED','DENIED','EXPIRED','REVOKED')) OR
+    (OLD.status = 'APPROVED' AND NEW.status IN ('CONSUMED','EXPIRED','REVOKED')))
+BEGIN SELECT RAISE(ABORT, 'approval transition forbidden; consumed grants never revive'); END;
+CREATE TRIGGER approval_no_replace BEFORE INSERT ON approvals
+WHEN EXISTS (SELECT 1 FROM approvals WHERE approval_id = NEW.approval_id OR operation_id = NEW.operation_id OR nonce_hash = NEW.nonce_hash)
+BEGIN SELECT RAISE(ABORT, 'approval replacement or duplicate forbidden'); END;
+CREATE TRIGGER approval_no_delete BEFORE DELETE ON approvals
+BEGIN SELECT RAISE(ABORT, 'approval evidence cannot be deleted by runtime'); END;
+
+CREATE TRIGGER attempt_identity_immutable BEFORE UPDATE ON operation_attempts
+WHEN NEW.attempt_id IS NOT OLD.attempt_id OR NEW.operation_id IS NOT OLD.operation_id
+  OR NEW.attempt_no IS NOT OLD.attempt_no OR NEW.approval_id IS NOT OLD.approval_id
+  OR NEW.runtime_epoch IS NOT OLD.runtime_epoch OR NEW.fencing_token IS NOT OLD.fencing_token
+  OR NEW.dispatch_id IS NOT OLD.dispatch_id OR NEW.executor_id IS NOT OLD.executor_id
+  OR NEW.claim_cancel_revision IS NOT OLD.claim_cancel_revision
+  OR NEW.claim_policy_version IS NOT OLD.claim_policy_version
+  OR NEW.claim_identity_epoch IS NOT OLD.claim_identity_epoch OR NEW.lease_set_json IS NOT OLD.lease_set_json
+  OR NEW.created_at IS NOT OLD.created_at
+  OR (OLD.dispatch_started_at IS NOT NULL AND NEW.dispatch_started_at IS NOT OLD.dispatch_started_at)
+BEGIN SELECT RAISE(ABORT, 'attempt identity and dispatch intent are immutable'); END;
+CREATE TRIGGER attempt_terminal_guard BEFORE UPDATE ON operation_attempts
+WHEN OLD.status IN ('SUCCEEDED','FAILED','ABANDONED','CANCELLED')
+BEGIN SELECT RAISE(ABORT, 'terminal attempt is immutable'); END;
+CREATE TRIGGER attempt_no_replace BEFORE INSERT ON operation_attempts
+WHEN EXISTS (SELECT 1 FROM operation_attempts WHERE attempt_id = NEW.attempt_id OR dispatch_id = NEW.dispatch_id OR (operation_id = NEW.operation_id AND attempt_no = NEW.attempt_no))
+BEGIN SELECT RAISE(ABORT, 'attempt replacement or duplicate forbidden'); END;
+CREATE TRIGGER attempt_no_delete BEFORE DELETE ON operation_attempts
+BEGIN SELECT RAISE(ABORT, 'attempt ledger deletion requires explicit maintenance'); END;
+
+CREATE TRIGGER task_identity_immutable BEFORE UPDATE ON tasks
+WHEN NEW.task_id IS NOT OLD.task_id OR NEW.session_id IS NOT OLD.session_id
+  OR NEW.owner_id IS NOT OLD.owner_id OR NEW.budget_id IS NOT OLD.budget_id
+BEGIN SELECT RAISE(ABORT, 'task ownership is immutable'); END;
+CREATE TRIGGER task_terminal_guard BEFORE UPDATE ON tasks
+WHEN OLD.state IN ('SUCCEEDED','PARTIAL','FAILED','CANCELLED') AND NEW.state <> OLD.state
+BEGIN SELECT RAISE(ABORT, 'terminal task cannot be reopened'); END;
+CREATE TRIGGER task_unknown_completion_guard BEFORE UPDATE ON tasks
+WHEN NEW.state IN ('SUCCEEDED','CANCELLED') AND EXISTS (
+    SELECT 1 FROM operations WHERE task_id = NEW.task_id AND state IN ('UNKNOWN','DISPATCHING'))
+BEGIN SELECT RAISE(ABORT, 'task has unresolved external outcome'); END;
+
+CREATE TRIGGER lease_fence_guard BEFORE UPDATE ON resource_leases
+WHEN NEW.version <> OLD.version + 1 OR NEW.resource_key IS NOT OLD.resource_key
+  OR NEW.resource_type IS NOT OLD.resource_type OR NEW.fencing_token < OLD.fencing_token
+  OR (NEW.state = 'HELD' AND (OLD.state <> 'HELD' OR NEW.holder_attempt_id IS NOT OLD.holder_attempt_id OR NEW.runtime_epoch IS NOT OLD.runtime_epoch)
+      AND NEW.fencing_token <= OLD.fencing_token)
+BEGIN SELECT RAISE(ABORT, 'lease version or fencing invariant'); END;
+CREATE TRIGGER lease_no_delete BEFORE DELETE ON resource_leases
+BEGIN SELECT RAISE(ABORT, 'lease counters must not be deleted or reset'); END;
+CREATE TRIGGER lease_no_replace BEFORE INSERT ON resource_leases
+WHEN EXISTS (SELECT 1 FROM resource_leases WHERE resource_key = NEW.resource_key)
+BEGIN SELECT RAISE(ABORT, 'lease replacement forbidden; use explicit CAS update'); END;
+
+CREATE TRIGGER tool_definition_immutable BEFORE UPDATE ON tool_registry
+WHEN NEW.tool_id IS NOT OLD.tool_id OR NEW.tool_version IS NOT OLD.tool_version
+  OR NEW.manifest_digest IS NOT OLD.manifest_digest OR NEW.package_digest IS NOT OLD.package_digest
+  OR NEW.installation_ref IS NOT OLD.installation_ref OR NEW.manifest_json IS NOT OLD.manifest_json
+  OR NEW.registered_at IS NOT OLD.registered_at
+BEGIN SELECT RAISE(ABORT, 'tool definition is immutable; register a new pinned definition'); END;
+CREATE TRIGGER tool_definition_no_replace BEFORE INSERT ON tool_registry
+WHEN EXISTS (SELECT 1 FROM tool_registry WHERE tool_id = NEW.tool_id AND tool_version = NEW.tool_version AND manifest_digest = NEW.manifest_digest)
+BEGIN SELECT RAISE(ABORT, 'tool definition replacement forbidden'); END;
+CREATE TRIGGER artifact_object_immutable BEFORE UPDATE ON artifacts
+WHEN NEW.object_id IS NOT OLD.object_id OR NEW.object_key IS NOT OLD.object_key
+  OR NEW.sha256 IS NOT OLD.sha256 OR NEW.mime IS NOT OLD.mime OR NEW.bytes IS NOT OLD.bytes
+  OR NEW.classification IS NOT OLD.classification OR NEW.created_at IS NOT OLD.created_at
+BEGIN SELECT RAISE(ABORT, 'artifact object identity is immutable'); END;
+CREATE TRIGGER artifact_no_replace BEFORE INSERT ON artifacts
+WHEN EXISTS (SELECT 1 FROM artifacts WHERE object_id = NEW.object_id OR object_key = NEW.object_key)
+BEGIN SELECT RAISE(ABORT, 'artifact replacement forbidden'); END;
+CREATE TRIGGER inbox_identity_immutable BEFORE UPDATE ON inbox
+WHEN NEW.inbox_id IS NOT OLD.inbox_id OR NEW.source_scope IS NOT OLD.source_scope
+  OR NEW.external_event_id IS NOT OLD.external_event_id OR NEW.channel_account_id IS NOT OLD.channel_account_id
+  OR NEW.payload_hash IS NOT OLD.payload_hash OR NEW.normalized_payload_json IS NOT OLD.normalized_payload_json
+  OR NEW.received_at IS NOT OLD.received_at
+BEGIN SELECT RAISE(ABORT, 'inbox identity and received content are immutable'); END;
+CREATE TRIGGER inbox_no_replace BEFORE INSERT ON inbox
+WHEN EXISTS (SELECT 1 FROM inbox WHERE inbox_id = NEW.inbox_id OR (source_scope = NEW.source_scope AND external_event_id = NEW.external_event_id))
+BEGIN SELECT RAISE(ABORT, 'inbox replacement or duplicate forbidden'); END;
+CREATE TRIGGER outbox_payload_immutable BEFORE UPDATE ON outbox
+WHEN NEW.outbox_id IS NOT OLD.outbox_id OR NEW.task_id IS NOT OLD.task_id
+  OR NEW.channel_account_id IS NOT OLD.channel_account_id OR NEW.target_key IS NOT OLD.target_key
+  OR NEW.target_json IS NOT OLD.target_json OR NEW.semantic_key IS NOT OLD.semantic_key
+  OR NEW.revision IS NOT OLD.revision OR NEW.payload_ref IS NOT OLD.payload_ref OR NEW.payload_json IS NOT OLD.payload_json
+  OR NEW.delivery_class IS NOT OLD.delivery_class OR NEW.provider_idempotency_key IS NOT OLD.provider_idempotency_key
+  OR NEW.created_at IS NOT OLD.created_at
+BEGIN SELECT RAISE(ABORT, 'outbox payload is immutable; create a new revision'); END;
+CREATE TRIGGER outbox_no_replace BEFORE INSERT ON outbox
+WHEN EXISTS (SELECT 1 FROM outbox WHERE outbox_id = NEW.outbox_id OR (target_key = NEW.target_key AND semantic_key = NEW.semantic_key AND revision = NEW.revision))
+BEGIN SELECT RAISE(ABORT, 'outbox revision replacement forbidden'); END;
+
+-- Explicit BEFORE INSERT guards also reject INSERT OR REPLACE for protected
+-- append-only records. Normal application writers must never use REPLACE.
+CREATE TRIGGER events_no_update BEFORE UPDATE ON events
+BEGIN SELECT RAISE(ABORT, 'events are append-only'); END;
+CREATE TRIGGER events_no_delete BEFORE DELETE ON events
+BEGIN SELECT RAISE(ABORT, 'events are append-only; purge requires explicit maintenance'); END;
+CREATE TRIGGER events_no_replace BEFORE INSERT ON events
+WHEN EXISTS (SELECT 1 FROM events WHERE event_id = NEW.event_id OR seq = NEW.seq)
+BEGIN SELECT RAISE(ABORT, 'event replacement forbidden'); END;
+CREATE TRIGGER policy_no_update BEFORE UPDATE ON policy_revisions
+BEGIN SELECT RAISE(ABORT, 'policy revisions are append-only'); END;
+CREATE TRIGGER policy_no_delete BEFORE DELETE ON policy_revisions
+BEGIN SELECT RAISE(ABORT, 'policy evidence cannot be deleted by runtime'); END;
+CREATE TRIGGER policy_no_replace BEFORE INSERT ON policy_revisions
+WHEN EXISTS (SELECT 1 FROM policy_revisions WHERE version = NEW.version OR digest = NEW.digest)
+BEGIN SELECT RAISE(ABORT, 'policy replacement forbidden'); END;
+CREATE TRIGGER migration_no_update BEFORE UPDATE ON schema_migrations
+BEGIN SELECT RAISE(ABORT, 'migration records are immutable'); END;
+CREATE TRIGGER migration_no_delete BEFORE DELETE ON schema_migrations
+BEGIN SELECT RAISE(ABORT, 'migration records are immutable'); END;
+CREATE TRIGGER migration_no_replace BEFORE INSERT ON schema_migrations
+WHEN EXISTS (SELECT 1 FROM schema_migrations WHERE version = NEW.version)
+BEGIN SELECT RAISE(ABORT, 'migration replacement forbidden'); END;
