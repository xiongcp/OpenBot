+            while idx < len(all_msgs):
+                msg = all_msgs[idx]
+                if (
+                    msg.role == "ASSISTANT"
+                    and msg.tool_call_id is not None
+                    and idx + 1 < len(all_msgs)
+                    and all_msgs[idx + 1].role == "TOOL"
+                    and all_msgs[idx + 1].tool_call_id == msg.tool_call_id
+                ):
+                    units.append([msg, all_msgs[idx + 1]])
+                    idx += 2
+                else:
+                    units.append([msg])
