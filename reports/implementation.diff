+@pytest.mark.parametrize(
+    "loop",
+    [
+        {"$defs": {"loop": {"$anchor": "loop", "allOf": [{"$ref": "#loop"}]}}, "$ref": "#loop"},
+        {"$defs": {"loop": {"$ref": "#/%24defs/loop"}}, "$ref": "#/$defs/loop"},
