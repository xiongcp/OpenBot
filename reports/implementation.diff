+            "INSERT INTO events(event_id,aggregate_kind,aggregate_id,aggregate_version,task_id,"
+            "actor_principal_id,event_type,schema_version,trace_id,payload_json,created_at) "
+            "VALUES(?,'Context',?,?,?,?,?,1,?,?,?)",
