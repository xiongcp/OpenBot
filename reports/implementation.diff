+
+def test_noop_startup_rejects_foreign_key_corruption(tmp_path):
+    path = tmp_path / "state.sqlite"
+    migrations = load_migrations(ROOT / "db/migrations") + [
+        Migration(
+            3,
+            "foreign_key_fixture",
