+def _allocate_fence(db: sqlite3.Connection, now: int) -> int:
+    row = db.execute("SELECT last_fencing_token FROM profile_config WHERE singleton=1").fetchone()
+    if row is None:
+        raise PermissionError("Profile config missing")
+    fence = int(row[0]) + 1
