+            receipt = {
+                "task_id": task_id,
+                "state": "QUEUED",
+                "version": task_version + 1,
+                "operation_id": operation_id,
+                "operation_state": op_state,
+                "approval_id": approval_id,
+                "approval_status": status,
+                "approval_version": row[1] + 2,
