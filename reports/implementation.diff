+def test_huge_integer_is_a_contract_error():
+    with pytest.raises(ContractError):
+        strict_json("1" + "0" * 5000)
+
+
+def test_document_constructor_rejects_mutable_or_noncanonical_bytes():
+    for value in [bytearray(b"{}"), b'{"z":1,"a":2}']:
+        with pytest.raises(ContractError):
