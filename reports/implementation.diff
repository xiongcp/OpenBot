+    if initial_state == "PENDING" and delivery_class == "UPSERT_REVISION":
+        db.execute(
+            "UPDATE outbox SET state='SUPERSEDED',version=version+1,updated_at=? "
+            "WHERE target_key=? AND semantic_key=? AND state='PENDING' AND revision<?",
