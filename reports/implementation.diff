+def test_process_exit_after_ddl_does_not_leave_half_migration(tmp_path):
+    path = tmp_path / "state.sqlite"
+    migrations = load_migrations(ROOT / "db/migrations")
+    migrate(path, migrations)
+    code = """
+import os,sqlite3,sys
