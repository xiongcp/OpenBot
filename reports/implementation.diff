--- /dev/null
+++ b/.github/workflows/pr.yml
@@ -0,0 +1,26 @@
+name: contracts
+on: [push, pull_request]
+permissions:
+  contents: read
+jobs:
+  minimal:
+    strategy:
+      fail-fast: false
+      matrix:
+        os: [ubuntu-24.04, macos-14, windows-2022]
+    runs-on: ${{ matrix.os }}
+    steps:
+      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
+      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
+        with:
+          python-version: '3.12.12'
+      - run: python -m pip install uv==0.9.26
+      - run: uv sync --locked
+      - run: uv run --no-sync openbot version
+      - run: uv run --no-sync ruff check
+      - run: uv run --no-sync mypy
+      - run: uv run --no-sync pytest
+      - run: uv run --no-sync python scripts/check_components.py
+      - run: python validation/verify_design.py
+      - run: python validation/verify_components.py
+      - run: python validation/verify_database.py
--- /dev/null
+++ b/THIRD_PARTY_NOTICES.md
@@ -0,0 +1,5 @@
+# 当前本地开发依赖
+
+本仓库未发布应用。M0 安装包和许可索引为 components/admissions/m0.json，许可原文在 evidence/implementation/licenses。未来发行物需按 OB-096 对实际内容重新生成 NOTICE / SBOM，不把开发机清单当三平台发行证明。
+
+Python 使用 PSF 许可，SQLite 上游声明 public domain；当前所用 Python 构建包含的完整第三方声明以仓库内 .python 发行物的 LICENSE 文本为准。uv 为 MIT / Apache-2.0 双许可工具，未在应用中 vendoring。所有候选框架和源码参考均未因设计目录而获得复制或运行授权。
