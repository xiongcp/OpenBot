+import secrets
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Literal
+
+import jsonschema
+
+_ALLOWED_SKILL_CAPABILITIES = frozenset(
+    {
+        "workspace.list",
+        "workspace.read",
+        "workspace.search",
+        "workspace.propose_patch",
+        "browser.open",
+        "browser.extract",
