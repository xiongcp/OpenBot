+                context.principal_id,
+                event_type,
+                "trc_" + hashlib.sha256(request_id.encode()).hexdigest()[:32],
+                payload,
+                now,
+            ),
+        )
+
+    def append_message(
+        self,
+        context: InboundContext,
+        task_id: str,
