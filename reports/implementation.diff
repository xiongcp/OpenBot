+class MemoryChallenges:
+    def __init__(self):
+        self.items: dict[str, bytes] = {}
+
+    def put(self, approval_id: str, nonce: bytes) -> None:
+        self.items[approval_id] = nonce
+
+    def get(self, approval_id: str) -> bytes | None:
+        return self.items.get(approval_id)
