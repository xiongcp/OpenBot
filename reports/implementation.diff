+        ops.propose(
+            context,
+            task_id,
+            "provider.send",
+            '{"body":"hello"}',
+            {"workspace_generation": 1, "files": []},
+            "WORKSPACE",
+            {"kind": "LOCAL", "resource_ref": context.workspace_id},
+            f"prop-{event_id}",
+            _deadline(),
+        )
+    )
+    op_id, apr_id = proposed["operation_id"], proposed["approval_id"]
+    nonce = challenges.get(apr_id).decode()
+    approvals.decide(
+        context,
+        apr_id,
