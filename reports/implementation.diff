+    try:
+        return _dispatch_authenticated(argv, session=session, as_json=as_json)
+    except ConnectionRefusedError as exc:
+        return 2, _format_output(
+            {"code": "DAEMON_UNAVAILABLE", "message": sanitize_terminal_text(str(exc))},
+            as_json=as_json,
