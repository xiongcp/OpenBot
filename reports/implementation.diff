+                        truncated = True
+                        reason = "MAX_GLOBAL_MATCHES"
+                        return SearchResult(
+                            matches=tuple(matches),
+                            files_scanned=scanned,
+                            truncated=True,
+                            truncation_reason=reason,
+                        )
+        return SearchResult(
+            matches=tuple(matches),
+            files_scanned=scanned,
+            truncated=truncated,
+            truncation_reason=reason,
+        )
