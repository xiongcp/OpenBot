+        context: InboundContext,
+        task_id: str,
+        *,
+        model: str,
+        max_context_tokens: int,
+        tool_count: int = 0,
+        multimodal_count: int = 0,
+    ) -> ModelContextSnapshot:
+        if max_context_tokens <= 0:
+            raise ValueError("max_context_tokens must be positive")
