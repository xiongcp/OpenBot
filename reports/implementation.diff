+            "WAITING_INPUT",
+            "WAITING_RESOURCE",
+            "RECONCILING",
+            "PAUSED",
+            "SUCCEEDED",
+            "PARTIAL",
+            "FAILED",
+            "CANCELLED",
+        }
+    ),
+    "WAITING_APPROVAL": _WAITING,
+    "WAITING_INPUT": _WAITING,
+    "WAITING_RESOURCE": _WAITING,
+    "RECONCILING": frozenset({"QUEUED", "PARTIAL", "FAILED", "CANCELLED"}),
+    "PAUSED": frozenset({"QUEUED", "CANCELLED"}),
+    "SUCCEEDED": frozenset(),
+    "PARTIAL": frozenset(),
+    "FAILED": frozenset(),
+    "CANCELLED": frozenset(),
