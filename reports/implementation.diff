+            "SELECT payload_json FROM events WHERE json_extract(payload_json,'$.request_id')=?",
+            (request_id,),
+        ).fetchone()
+        if not row:
+            return None
+        payload = strict_json(row[0])
+        return LookupResult(payload["command_hash"], canonicalize(payload["receipt"]))
