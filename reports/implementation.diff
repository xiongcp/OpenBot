--- /dev/null
+++ b/.github/workflows/platform-macos.yml
@@ -0,0 +1,12 @@
+name: platform-macos
+on:
+  pull_request:
+  workflow_dispatch:
+jobs:
+  macos-arm64-gate:
+    runs-on: macos-14
+    steps:
+      - uses: actions/checkout@v4
+      - name: Run macOS ARM64 native platform gate
+        run: |
+          python3 -m pytest tests/integration/platform/macos/test_macos_native_gate.py -q
--- /dev/null
+++ b/.github/workflows/pr.yml
@@ -0,0 +1,26 @@
+name: contracts
+on: [push, pull_request]
+permissions:
+  contents: read
+jobs:
+  minimal:
+    strategy:
+      fail-fast: false
+      matrix:
+        os: [ubuntu-24.04, macos-14, windows-2022]
+    runs-on: ${{ matrix.os }}
+    steps:
+      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
+      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
+        with:
+          python-version: '3.12.12'
+      - run: python -m pip install uv==0.9.26
+      - run: uv sync --locked
+      - run: uv run --no-sync openbot version
+      - run: uv run --no-sync ruff check
+      - run: uv run --no-sync mypy
+      - run: uv run --no-sync pytest
+      - run: uv run --no-sync python scripts/check_components.py
+      - run: python validation/verify_design.py
+      - run: python validation/verify_components.py
+      - run: python validation/verify_database.py
--- /dev/null
+++ b/THIRD_PARTY_NOTICES.md
@@ -0,0 +1,5 @@
