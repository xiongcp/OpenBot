+            rows = db.execute(
+                "SELECT message_id,turn,role,provider_call_id,tool_call_id,content_ref,"
+                "content_json,provenance_json FROM messages WHERE task_id=? AND turn>=? "
+                "ORDER BY turn",
+                (task_id, min_turn),
+            ).fetchall()
