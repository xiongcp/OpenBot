+    "WORKSPACE": (0, "workspace"),
+    "BROWSER_PROFILE": (1, "browser_profile"),
+    "DESKTOP_SESSION": (2, "desktop_session"),
+    "EXTERNAL_ACCOUNT": (3, "external_account"),
