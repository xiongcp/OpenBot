+            try:
+                os.killpg(ident.pgid, signal.SIGKILL)
+                forced_sent = True
+            except (ProcessLookupError, PermissionError):
+                pass
+            for d_pid in (ident.pid, *ident.known_descendant_pids):
+                if _pid_alive(d_pid):
+                    try:
+                        os.kill(d_pid, signal.SIGKILL)
+                        forced_sent = True
+                    except ProcessLookupError:
+                        pass
+            time.sleep(0.02)
