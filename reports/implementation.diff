+        return {
+            "schema_version": self.schema_version,
+            "db_sha256": self.db_sha256,
+            "artifacts": list(self.artifacts),
+            "secret_refs": list(self.secret_refs),
+            "status": self.status,
+            "created_at_ms": self.created_at_ms,
+            "contains_secret_values": False,
+        }
+
